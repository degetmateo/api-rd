# Server Port (Render sets this automatically)
PORT=3000
NODE_ENV=production

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/libreriard?retryWrites=true&w=majority

# Meta WhatsApp Webhook Verification Token (Configure in Meta Developer Dashboard)
WEBHOOK_VERIFY_TOKEN=libreria_rd_webhook_verify_token

# Master Secret Key for Electron Client & Admin authentication
SERVER_API_KEY=libreriard-secret-key-2026

# Meta WhatsApp Cloud API Token (Bearer)
META_TOKEN=EAAdvf...

